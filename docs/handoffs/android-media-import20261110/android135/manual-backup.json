  "entries": [
    {
      "id": "2ceb4b61-ee2d-4cb6-9057-329fb9abc2d5",
      "createdAt": 1794285900681,
      "text": "公开验收已核对：周二复核12000元预算，负责人 Alex。",
      "atMs": 12000,
      "updatedAt": 1794286002203
    },
    {
      "id": "ac4ff1f0-7a1f-479c-a5d4-e95a9c73f804",
      "text": "公开白板资料：这是人工补充，不是转写事实。",
      "atMs": 25000,
      "image": {
        "file": "b062f8da140d32c12e7d24cb3e200ecaf247ee226b9a19ffc5c7cec389be9337.context-ac4ff1f0-7a1f-479c-a5d4-e95a9c73f804.png",
