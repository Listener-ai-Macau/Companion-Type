{
  "name": "companion-type",
  "private": true,
  "version": "0.1.139",
  "type": "module",
  "scripts": {
    "dev:windows": "vite --config apps/windows/vite.config.ts",
    "dev:mobile": "vite --config apps/mobile/vite.config.ts",
    "build": "npm run build:windows && npm run build:mobile",
    "build:windows": "node tools/verify_third_party_notices.mjs && tsc -p apps/windows/tsconfig.json && vite build --config apps/windows/vite.config.ts",
    "build:mobile": "tsc -p apps/mobile/tsconfig.json && vite build --config apps/mobile/vite.config.ts",
    "test": "npm run test:core",
    "test:core": "node tools/test_software_contracts.mjs core",
    "test:ui": "node tools/test_companion_setup_render.mjs",
    "test:core:write-docs": "node --experimental-strip-types packages/core/src/companionV1.test.ts --write-docs",
    "verify:user-chain": "node --experimental-strip-types tools/verify_companion_type_user_chain.ts",
    "verify:backend-shape": "node --experimental-strip-types tools/verify_companion_type_backend_shape.ts",
    "verify:host-recording": "node --experimental-strip-types tools/verify_companion_type_host_recording.ts",
    "verify:mechanical-voice-minutes": "node --experimental-strip-types tools/verify_companion_type_mechanical_voice_minutes.ts",
    "verify:native-deepseek-minutes": "node --experimental-strip-types tools/verify_companion_type_native_deepseek_minutes.ts",
    "verify:native-minutes-gui": "playwright test tools/verify_companion_type_native_minutes_gui.spec.cjs --reporter=line",
    "verify:virtual-owner-minutes": "node --experimental-strip-types tools/verify_companion_type_virtual_owner_minutes.ts",
    "verify:real-microphone": "node --experimental-strip-types tools/verify_companion_type_real_microphone.ts",
    "verify:real-microphone-soak": "node --experimental-strip-types tools/verify_companion_type_real_microphone_soak.ts",
    "verify:real-microphone-soak:popup": "pwsh -NoProfile -File tools/run_companion_type_real_microphone_soak_popup.ps1",
    "verify:independent-asr": "node --experimental-strip-types tools/verify_companion_type_independent_asr_chain.ts",
    "verify:long-meeting": "node --experimental-strip-types tools/verify_companion_type_long_meeting_chain.ts",
    "verify:online-live": "node --experimental-strip-types tools/verify_companion_type_online_live_streaming.ts",
    "verify:dual-meeting-mode": "node --experimental-strip-types tools/verify_companion_type_dual_meeting_mode.ts",
    "verify:product-close": "node --experimental-strip-types tools/verify_companion_type_product_close.ts",
    "verify:mechanical-product-close": "node --experimental-strip-types tools/verify_companion_type_mechanical_product_close.ts",
    "verify:product-chain": "node --experimental-strip-types tools/verify_companion_type_product_chain.ts",
    "verify:dirty-audit": "node --experimental-strip-types tools/verify_companion_type_dirty_audit.ts",
    "verify:joint-acceptance": "node --experimental-strip-types tools/verify_companion_type_joint_acceptance.ts",
    "verify:msi-install-smoke": "pwsh -NoProfile -File tools/verify_companion_type_msi_install_smoke.ps1",
    "verify:installed-ui-sync": "pwsh -NoProfile -File tools/verify_companion_type_installed_ui_sync.ps1",
    "verify:final-human-signoff": "pwsh -NoProfile -File tools/verify_companion_type_final_human_signoff.ps1",
    "verify:browser-ui": "playwright test tools/verify_companion_type_browser_ui_chain.spec.cjs --reporter=line",
    "verify:capability-truth": "playwright test tools/verify_companion_type_capability_truth.spec.cjs --reporter=line",
    "verify:installed-capability-truth": "playwright test tools/verify_companion_type_installed_capability_truth.spec.cjs --reporter=line",
    "verify:installed-user-journey": "playwright test tools/verify_companion_type_installed_user_journey.spec.cjs --reporter=line",
    "tauri:windows": "tauri build --config apps/windows/src-tauri/tauri.conf.json",
    "tauri:windows:dev": "tauri dev --config apps/windows/src-tauri/tauri.conf.json",
    "test:customer-reading": "node tools/test_software_contracts.mjs customer"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.22.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "6.0.0",
    "xlsx": "file:vendor/document-context/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsqr": "1.4.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.3"
  }
}
