        intervals [46]:
            xmin = 1206.8046590582435 
            xmax = 1212.420501127868 
            text = "我们这边儿的话是准备刚才说了有老人，还有一些家里的卫生不是很干净这方面，" 
        intervals [47]:
            xmin = 1212.420501127868 
