            text = "" 
        intervals [24]:
            xmin = 541.39107 
            xmax = 553.5361 
            text = "对，而主要就是我们这儿的这个绿化这方面，主要就是他们那边儿负责就是出人手，进行对这些植物啊进行一些养护，" 
        intervals [25]:
