            text = "" 
        intervals [52]:
            xmin = 1224.58858 
            xmax = 1231.44484 
            text = "蹲地呀、扫地呀、擦桌子，就属于这方面，擦一下窗台儿不会有尘土。" 
        intervals [53]:
            xmin = 1231.44484 
