            text = "" 
        intervals [48]:
            xmin = 1212.86731 
            xmax = 1220.48232 
            text = "我们会采取一些上门儿服务，比方说去他们家经过允许以后给他们打扫一下家庭卫生，" 
        intervals [49]:
            xmin = 1220.48232 
