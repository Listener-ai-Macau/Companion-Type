  "rows": [
    {
      "index": 0,
      "text": "零二二我是郝志贵。",
      "localSpeaker": "S01",
      "nativeWholeMeetingSpeaker": 1,
      "start": 0.11,
      "end": 1.41,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 1,
      "text": "零二六我是周华志乐。",
      "localSpeaker": "S02",
      "nativeWholeMeetingSpeaker": 2,
      "start": 1.83,
      "end": 3.23,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 2,
      "text": "零幺三我是画师。",
      "localSpeaker": "S03",
      "nativeWholeMeetingSpeaker": 3,
      "start": 3.72,
      "end": 5.35,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 3,
      "text": "零幺三我是角色设计。",
      "localSpeaker": "S04",
      "nativeWholeMeetingSpeaker": 4,
      "start": 5.68,
      "end": 7.41,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 4,
      "text": "零二四我们是剧本。",
      "localSpeaker": "S05",
      "nativeWholeMeetingSpeaker": 5,
      "start": 7.85,
      "end": 10.11,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 5,
      "text": "零二五我是呃制片监理，监理部。",
      "localSpeaker": "S06",
      "nativeWholeMeetingSpeaker": 6,
      "start": 10.52,
      "end": 14.25,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 6,
      "text": "嗯行好的。",
      "localSpeaker": "S07",
      "nativeWholeMeetingSpeaker": 0,
      "start": 14.55,
      "end": 15.89,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 7,
      "text": "呃。",
      "localSpeaker": "S07",
      "nativeWholeMeetingSpeaker": 0,
      "start": 16.41,
      "end": 17.35,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 8,
      "text": "受邀来到咱们参加咱们这个一个这个飞翼，飞亮展，那个京都这个。",
      "localSpeaker": "S07",
      "nativeWholeMeetingSpeaker": 0,
      "start": 17.94,
      "end": 24.65,
      "attribution": "predicted_identity_overlap_assignment"
    },
    {
      "index": 9,
      "text": "制片这一块儿。",
      "localSpeaker": "S07",
      "nativeWholeMeetingSpeaker": 0,
      "start": 25.88,
      "end": 27.35,
